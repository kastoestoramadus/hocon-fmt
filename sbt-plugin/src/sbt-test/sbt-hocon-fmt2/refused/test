# plus-equals.conf is a known sconfig defect, broken.conf is not HOCON, and latin1.conf is not
# UTF-8. Each is refused: reported, never written, and no reason to fail the build.
$ sleep 1000
$ touch before-format
$ sleep 1000

> hoconFormat
> assertWarnedOnce hoconFormat src/main/resources/plus-equals.conf src/main/resources/broken.conf src/main/resources/latin1.conf
> assertSameBytes src/main/resources/plus-equals.conf original/plus-equals.conf
> assertSameBytes src/main/resources/broken.conf original/broken.conf
> assertSameBytes src/main/resources/latin1.conf original/latin1.conf
-$ newer src/main/resources/plus-equals.conf before-format
-$ newer src/main/resources/broken.conf before-format
-$ newer src/main/resources/latin1.conf before-format

# A refusal does not stop the files after it from being formatted.
$ must-mirror src/main/resources/acceptable.conf expected/acceptable.conf

> hoconFormatCheck
> assertWarnedOnce hoconFormatCheck src/main/resources/plus-equals.conf src/main/resources/broken.conf src/main/resources/latin1.conf
