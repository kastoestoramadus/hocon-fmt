//| mill-version: 1.1.10
//| mill-jvm-version: 17
package build

import mill.*, scalalib.*, publish.*

// Compile for the oldest supported host; the formatter's Scala is resolved only at task time.
object `package` extends ScalaModule, PublishModule {
  def millVersion      = "1.1.4"
  def formatterVersion = "0.1.0"

  def scalaVersion   = "3.8.2"
  def platformSuffix = "_mill1"
  def artifactName   = "mill-hocon-fmt"

  def compileMvnDeps = Seq(mvn"com.lihaoyi::mill-libs:$millVersion")

  def generatedSources = Task {
    val source = Task.dest / "FormatterArtifact.scala"
    os.write.over(source,
      s"""package eu.ww86.hoconfmt.mill
         |private[mill] object FormatterArtifact { val version = "$formatterVersion" }
         |""".stripMargin)
    super.generatedSources() :+ PathRef(source)
  }

  // Mill libraries use the ordinary Scala suffix, rather than the plugin platform suffix.
  protected def resolvedDepsWarnNonPlatform = Task { false }

  // As in build.sbt: the repository's brace rule is a compile error here too, and the nested
  // test and integration modules inherit these options.
  def scalacOptions = Seq("-deprecation", "-feature", "-Werror", "-no-indent")

  // Mill loads its own libraries at run time; its tests need them on the classpath.
  object test extends ScalaTests, TestModule.Munit {
    def munitVersion = "1.2.4"
    def mvnDeps      = build.compileMvnDeps() :+ mvn"com.lihaoyi::mill-testkit:$millVersion"
  }

  // Runs a real Mill, which loads the plugin from a repository it was published to: the oldest
  // Mill the plugin supports, and the newest it is known to work on.
  object integration extends Cross[Integration](millVersion, "1.1.10")

  trait Integration extends ScalaTests, TestModule.Munit, Cross.Module[String] {
    def munitVersion = "1.2.4"
    def mvnDeps      = Seq(mvn"com.lihaoyi::mill-testkit:$millVersion")
    def forkEnv = Task {
      // Local publication supplies the Java API and core until they are on Maven Central.
      val repositories = Seq(
        publishLocalTestRepo().path.toNIO.toUri.toASCIIString,
        Task.env.getOrElse("COURSIER_REPOSITORIES", "ivy2Local|central")
      )
      super.forkEnv() ++ Map(
        "MILL_EXECUTABLE_PATH"  -> millExecutable.assembly().path.toString,
        "COURSIER_REPOSITORIES" -> repositories.mkString("|"),
        "PLUGIN_UNDER_TEST"     -> s"${build.pomSettings().organization}::${build.artifactName()}::${build.publishVersion()}"
      )
    }

    object millExecutable extends JavaModule {
      def mvnDeps   = Seq(mvn"com.lihaoyi:mill-runner-launcher_3:$crossValue")
      def mainClass = Some("mill.launcher.MillLauncherMain")
    }
  }

  def publishVersion = formatterVersion
  def pomSettings = PomSettings(
    description = "Formats HOCON configuration files, or fails the build when they are not formatted.",
    organization = "eu.ww86",
    url = "https://github.com/kastoestoramadus/hocon-fmt",
    licenses = Seq(License.`GPL-3.0-only`),
    versionControl = VersionControl.github("kastoestoramadus", "hocon-fmt"),
    developers = Seq(Developer("kastoestoramadus", "Waldemar Wosinski", "https://github.com/kastoestoramadus"))
  )
}
